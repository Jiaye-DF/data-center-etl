# production — 部署平台(Coolify Environment Variables)填入實際值,**禁**沿用 development / staging 預設
# 欄位對齊 docker-compose-production.yml 實際插值變數
# Coolify 應用需將 Docker Compose Location 設為 /docker-compose-production.yml

# ───────────────────────────────
# 環境
# ───────────────────────────────
APP_ENV=production

# ───────────────────────────────
# PostgreSQL / 資料庫(應用自有 DB,非 ETL 的 RDS)
#   POSTGRES_*   → docker-compose 注入 postgres image + 自組 DATABASE_URL
#   DATABASE_URL → compose 以 service name 自組,**不需在此填**
#   POSTGRES_VERSION → image tag(對齊 00-overview/01-versions.md 鎖定線)
# ───────────────────────────────
POSTGRES_VERSION=18
POSTGRES_DB=data_center_etl
POSTGRES_USER=
POSTGRES_PASSWORD=

# ───────────────────────────────
# 後端 uvicorn 行程數 + DB 連線池(消弭單一事件迴圈單點,間歇 502 對策)
#   ⚠️ 連線總量須 < postgres max_connections(預設 100):
#      (UVICORN_WORKERS × (DB_POOL_SIZE+DB_MAX_OVERFLOW)) + worker + scheduler 各 (pool+overflow)
#      例:UVICORN_WORKERS=2, POOL=5, OVERFLOW=5 → backend 2×10=20 + worker 10 + scheduler 10 = 40 < 100
#   worker 數建議對齊機器 vCPU;調高 worker 記憶體同步上升,須確認機器餘裕(OOM 亦會致 502)
# ───────────────────────────────
UVICORN_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ───────────────────────────────
# 認證 / JWT(32+ 字元隨機:openssl rand -base64 32;禁沿用他層)
# ───────────────────────────────
JWT_SECRET_KEY=

# ───────────────────────────────
# CORS(允許的前端來源;限本網域,禁 ["*"])
# ───────────────────────────────
CORS_ORIGINS=["https://app.example.com"]

# ───────────────────────────────
# 初始管理員(必填,缺值啟動 fail-fast;禁沿用 development / staging 值)
# ───────────────────────────────
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# ───────────────────────────────
# AWS RDS(ETL 來源/目標;worker 執行同步時使用)
#   來源(ERP 移轉庫)與目標(資料中心庫)為同一顆 RDS 的兩個 database
#   連線組(HOST/PORT/USER/PASSWORD)只填一次,database 各自填
# ───────────────────────────────
AWS_RDS_HOST=
AWS_RDS_PORT=5432
AWS_RDS_USER=
AWS_RDS_PASSWORD=
AWS_RDS_SOURCE_DB=
AWS_RDS_TARGET_DB=

# ───────────────────────────────
# DF-SSO 中央登入器(IT 發放 production 憑證;先留空 = SSO 休眠)
#   SSO_URL / SSO_APP_ID → 後端用(與下方 NEXT_PUBLIC_* 同值)
#   SSO_APP_SECRET       → server only,**禁**進前端
#   FRONTEND_URL         → SSO 回呼 / logout 導回前端的網址
# ───────────────────────────────
SSO_URL=
SSO_APP_ID=
SSO_APP_SECRET=
FRONTEND_URL=https://app.example.com

# ───────────────────────────────
# Cookie Domain(跨子網域共用登入 cookie)
#   前後端在不同 *.zerozero.tw 子網域時必填,設為共同上層網域(前綴點)讓所有子網域收得到
#   留空 = host-only(cookie 綁單一 host,跨子網域收不到)
# ───────────────────────────────
COOKIE_DOMAIN=.zerozero.tw

# ───────────────────────────────
# 前端可公開 env(build 時烘入 bundle;compose build args 傳入)
#   NEXT_PUBLIC_API_URL      → backend 對外網址(含 /api/v1)
#   NEXT_PUBLIC_SSO_URL      → 同 SSO_URL(前端組 authorize URL 用)
#   NEXT_PUBLIC_SSO_APP_ID   → 同 SSO_APP_ID
#   機密 SSO_APP_SECRET 禁入前端(此區無對應)
# ───────────────────────────────
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SSO_URL=
NEXT_PUBLIC_SSO_APP_ID=

# ───────────────────────────────
# Coolify 平台自動處理(不需手填;列此供與 compose 對照)
#   DATABASE_URL / REDIS_URL         → compose 以 postgres / redis service name 自組
#   SERVICE_URL_FRONTEND_3000 /
#   SERVICE_URL_BACKEND_8000         → Coolify 依你綁定的 Domain 自動產生 → 改為在 UI 設對外 Domain
#   COMPOSE_PROJECT_NAME             → Coolify 自動提供(volume 命名依賴);**勿手填空值**
# ───────────────────────────────
