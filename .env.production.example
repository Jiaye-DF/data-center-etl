# production — 部署平台(Coolify Environment Variables)填入實際值,**禁**沿用 development / staging 預設
# 欄位對齊 docker-compose-production.yml 實際插值變數;DATABASE_URL / REDIS_URL 由 compose 以 service name 自組,不在此填
APP_ENV=production

# ─── PostgreSQL(compose 注入 postgres 服務並自組 DATABASE_URL)───
POSTGRES_DB=data_center_etl
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

# ─── 認證 / JWT(32+ 字元隨機:openssl rand -base64 32;禁沿用他層)───
JWT_SECRET_KEY=__GENERATE_AT_DEPLOY__

# ─── CORS(限本網域,禁 ["*"])───
CORS_ORIGINS=["https://app.example.com"]

# ─── 初始管理員 — 必填,缺值啟動 fail-fast;**禁**預設帳密(禁沿用 development / staging 值)───
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# ─── ETL 來源 DB(ERP 移轉庫,DMS 同步進 RDS;worker 執行 run_etl 時讀取)───
# SOURCE / TARGET 為同一顆 RDS,僅 database 不同 → HOST / PORT(/USER)填相同值,*_DB_NAME 各自填
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=

# ─── ETL 目標 DB(資料中心庫,同一顆 RDS 的另一 database;worker 執行 run_etl 時寫入)───
TARGET_DB_HOST=
TARGET_DB_PORT=5432
TARGET_DB_NAME=
TARGET_DB_USER=
TARGET_DB_PASSWORD=

# ─── DF-SSO 中央登入器(IT 發放 production 憑證)───
SSO_URL=
SSO_APP_ID=
SSO_APP_SECRET=
FRONTEND_URL=https://app.example.com

# ─── 前端可公開 env(build 時烘入 bundle;compose build args 傳入)───
# NEXT_PUBLIC_API_URL 填 backend 對外網址(含 /api/v1);機密 SSO_APP_SECRET 禁入前端
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SSO_URL=
NEXT_PUBLIC_SSO_APP_ID=
