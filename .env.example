# .env.example — 環境變數範本(v1.1.0)
# 值一律佔位符,禁真實機密(docs/Design-Base/00-overview/02-secrets.md)
# 本地使用:cp .env.example .env 後填入實際值;留空欄位啟動會 fail-fast,務必補齊
# localhost 僅本地開發層;部署時由 Coolify 注入 process env,禁把 .env 檔帶進容器
# (docs/Design-Base/00-overview/03-env-layers.md)

# ───────────────────────────────
# 環境(限 development / staging / production)
# ───────────────────────────────
APP_ENV=development

# compose 專案名(staging / production compose 的 volume 命名引用)
COMPOSE_PROJECT_NAME=data-center-etl

# ───────────────────────────────
# 本專案自有 PostgreSQL(compose postgres 服務;非 AWS RDS,ETL 來源/目標見下方 AWS_RDS_*)
#   POSTGRES_*   → docker compose 注入 postgres 服務(官方 image 命名,勿改前綴)
#   DATABASE_URL → backend / worker / scheduler 連線
#                  (本機 dev 走 localhost:5435;容器內由 compose 覆蓋為 service name)
# ───────────────────────────────
POSTGRES_VERSION=18
POSTGRES_DB=data_center_etl
POSTGRES_USER=data_center_etl
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://data_center_etl:CHANGE@localhost:5435/data_center_etl

# ───────────────────────────────
# 後端執行緒與 DB 連線池(單一事件迴圈為單點 → 多 uvicorn worker;多行程各一組池)
#   UVICORN_WORKERS  → backend uvicorn 行程數(compose command 插值;本地預設 2)
#   DB_POOL_SIZE / DB_MAX_OVERFLOW → 每行程池上限(= pool_size + max_overflow)
#   ⚠️ 連線總量須 < postgres max_connections(預設 100):
#      (UVICORN_WORKERS × (DB_POOL_SIZE+DB_MAX_OVERFLOW)) + worker + scheduler 各 (pool+overflow)
# ───────────────────────────────
UVICORN_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ───────────────────────────────
# 同步併發度(僅 worker 讀:單輪多表以 asyncio 併發鏡像)
#   SYNC_CONCURRENCY → 同輪同時鏡像的表數上限(預設 2)
#   ⚠️ 調高 → 來源 RDS 讀壓上升;來源 RDS 異常時設回 1 退化為序列同步
# ───────────────────────────────
SYNC_CONCURRENCY=2

# ───────────────────────────────
# 認證 / JWT(32+ 字元隨機:openssl rand -base64 32)
# ───────────────────────────────
JWT_SECRET_KEY=

# ───────────────────────────────
# CORS(允許的前端來源;禁 ["*"])
# ───────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ───────────────────────────────
# 初始管理員(必填 env,缺值啟動 fail-fast;禁預設帳密)
# ───────────────────────────────
INIT_ADMIN_USERNAME=init-admin
INIT_ADMIN_PASSWORD=

# ───────────────────────────────
# redis / taskiq 排程佇列
#   本機 dev 走 localhost;容器內由 compose 覆蓋為 redis://redis:6379/0
# ───────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────
# AWS RDS(ETL 來源/目標;worker 執行 run_etl 時使用,缺值於執行時 fail-fast)
#   來源與目標在同一 RDS 實例 → 連線組(HOST/PORT/USER/PASSWORD)共用,
#   只有 database 不同;與上方本專案自有 PostgreSQL(POSTGRES_*)無關,勿混用
# ───────────────────────────────
AWS_RDS_HOST=
AWS_RDS_PORT=5432
AWS_RDS_USER=
AWS_RDS_PASSWORD=
# ETL 來源 database(ERP 移轉庫,讀取)
AWS_RDS_SOURCE_DB=
# ETL 目標 database(資料中心庫,寫入)
AWS_RDS_TARGET_DB=

# ───────────────────────────────
# DF-SSO 中央登入器(IT 發放後填入;未填則僅本地帳密登入可用)
# ───────────────────────────────
SSO_URL=
SSO_APP_ID=
SSO_APP_SECRET=
FRONTEND_URL=http://localhost:3000
# Cookie Domain:本機開發留空 = host-only(localhost 免設);跨子網域部署才填 .zerozero.tw
COOKIE_DOMAIN=

# 前端可公開 env(Next.js build 時烘入 bundle;部署時作為前端 image build args)
# 值同 SSO_URL / SSO_APP_ID;機密 SSO_APP_SECRET 禁入前端(fixed.md §12)
# 後端 API base URL(staging / production compose build args 引用;本地 dev 由 frontend/.env.local 提供)
# 缺值前端 build 會 fail-fast(禁靜默烘 localhost 進 bundle)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SSO_URL=
NEXT_PUBLIC_SSO_APP_ID=
