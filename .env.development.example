APP_ENV=development
POSTGRES_VERSION=18
# postgres image 與 docker-compose 注入用(禁寫死於 compose,見 02-secrets.md)
POSTGRES_DB=data_center_etl
POSTGRES_USER=data_center_etl
POSTGRES_PASSWORD=changeme-development
DATABASE_URL=postgresql+asyncpg://data_center_etl:changeme-development@localhost:5432/data_center_etl
JWT_SECRET_KEY=changeme-32-bytes-very-very-secret
# 對外 API Client 短效 JWT 簽章密鑰(/api/client;必填、至少 32 字元,禁沿用 JWT_SECRET_KEY)
CLIENT_JWT_SECRET=changeme-development-client-jwt-secret-32
# client_secret 可逆加密金鑰(Fernet key,44 字元;development-only-not-for-production)
# 產生:python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLIENT_SECRET_ENCRYPTION_KEY=nxqVCj7ETrJ70iefIm3kfPKzlTtIN_6TflfYUHEeb_U=
CORS_ORIGINS=["http://localhost:3000"]
# 初始管理員(必填 env,缺值啟動 fail-fast;見 02-secrets.md)
INIT_ADMIN_USERNAME=init-admin
INIT_ADMIN_PASSWORD=changeme-development
