# staging — 部署平台填入實際值,**禁**沿用 development 預設
APP_ENV=staging
POSTGRES_VERSION=18
POSTGRES_DB=data_center_etl
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/data_center_etl
JWT_SECRET_KEY=__GENERATE_AT_DEPLOY__
CORS_ORIGINS=["https://staging.example.com"]
