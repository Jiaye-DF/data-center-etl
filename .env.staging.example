# staging — 部署平台(Coolify Environment Variables)填入實際值,**禁**沿用 development 預設
# 欄位對齊 docker-compose-staging.yml 實際插值變數;DATABASE_URL / REDIS_URL 由 compose 以 service name 自組,不在此填
# DB / 機密必須獨立(禁與 production 共用)
APP_ENV=staging

# ─── PostgreSQL(compose 注入 postgres 服務並自組 DATABASE_URL;獨立 DB,禁接 production)───
POSTGRES_DB=data_center_etl
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

# ─── 認證 / JWT(32+ 字元隨機:openssl rand -base64 32;禁沿用他層)───
JWT_SECRET_KEY=__GENERATE_AT_DEPLOY__

# ─── CORS(限本網域,禁 ["*"])───
CORS_ORIGINS=["https://staging.example.com"]

# ─── 初始管理員 — 必填,缺值啟動 fail-fast;**禁**預設帳密(禁沿用 development 值)───
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# ─── AWS RDS(ETL 來源/目標;staging 接 sandbox / 測試庫,禁接 production)───
# 來源與目標同一 RDS 實例,連線組共用,只有 database 不同;與本專案自有 PostgreSQL 無關
AWS_RDS_HOST=
AWS_RDS_PORT=5432
AWS_RDS_USER=
AWS_RDS_PASSWORD=
# ETL 來源 database(ERP 移轉庫,讀取)/ 目標 database(資料中心庫,寫入)
AWS_RDS_SOURCE_DB=
AWS_RDS_TARGET_DB=

# ─── DF-SSO 中央登入器(IT 發放 staging 憑證)───
SSO_URL=
SSO_APP_ID=
SSO_APP_SECRET=
FRONTEND_URL=https://staging.example.com

# ─── 前端可公開 env(build 時烘入 bundle;compose build args 傳入)───
# NEXT_PUBLIC_API_URL 填 backend 對外網址(含 /api/v1);機密 SSO_APP_SECRET 禁入前端
NEXT_PUBLIC_API_URL=https://api-staging.example.com/api/v1
NEXT_PUBLIC_SSO_URL=
NEXT_PUBLIC_SSO_APP_ID=
